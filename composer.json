{
    "name": "alfacode-team/hkm-plugin-school-archives",
    "description": "Scheduled and manual archival of people and academic records, and reading the archives back.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolArchives\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolArchives\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
